                "type": "path",
                "description": "Image ID"
              },
              {
                "name": "fileId",
                "value": "",
                "type": "path",
                "description": "File ID"
              }
            ]
          },
          "docs": "Get File by ID"
        },
        {
          "info": {
            "name": "List Files",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v4/products/:productId/images/:imageId/files",
            "params": [

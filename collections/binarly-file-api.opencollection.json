{
  "opencollection": "1.0.0",
  "info": {
    "name": "Binarly Assistant File API",
    "version": "4.275.2"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },

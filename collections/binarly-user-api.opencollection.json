{
  "opencollection": "1.0.0",
  "info": {
    "name": "Binarly Assistant User API",
    "version": "4.275.2"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "User",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Users",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v4/users"
          },
          "docs": "List Users"
        },
        {
          "info": {
            "name": "Create User",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v4/users",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create User"
        },
        {
          "info": {
            "name": "Bulk Delete Users",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v4/users:bulkDelete",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Bulk Delete Users"
        },
        {
          "info": {
            "name": "Get Current User",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v4/users/me"
          },
          "docs": "Get Current User"
        }
      ]
    }
  ],
  "bundled": true
}